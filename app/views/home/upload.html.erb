<div class="upload-container" data-controller="upload">
  <h2>Upload generation file (.txt)</h2>

  <div class="upload-form">
    <input 
      type="file" 
      id="file" 
      accept=".txt" 
      class="file-input"
      data-upload-target="file"
    />
    
    <button 
      id="upload-btn" 
      class="btn btn-primary"
      data-upload-target="button"
      data-action="click->upload#upload"
    >
      Upload
    </button>
  </div>
</div>
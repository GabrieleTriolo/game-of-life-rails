<!DOCTYPE html>
<html>
  <head>
    <title>Game of Life</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <nav class="navbar">
        <div>
          <%= link_to "Game of Life", root_path, class: "navbar-brand" %>
          <span class="navbar-links">
            <%= link_to "New Simulation", upload_path %>
            <%= link_to "My Simulations", simulations_path %>
          </span>
        </div>
        <div class="navbar-user">
          <span class="navbar-email"><%= current_user.email %></span>
          <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn-logout" %>
        </div>
      </nav>
    <% end %>

    <main>
      <% if notice %>
        <div class="alert alert-info">
          <%= notice %>
        </div>
      <% end %>
      
      <% if alert %>
        <div class="alert alert-danger">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
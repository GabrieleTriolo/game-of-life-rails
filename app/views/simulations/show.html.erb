<div 
  data-controller="simulation"
  data-simulation-simulation-id-value="<%= @simulation.id %>"
  data-simulation-user-id-value="<%= current_user.id %>"
>
  <h2>
    Generation <span id="gen"><%= @simulation.generation %></span>
  </h2>

  <div id="game_area">
    <%= render partial: "grid", locals: { grid: @simulation.grid } %>
  </div>

  <div style="margin-top: 1rem;">
    <label for="interval">Interval (ms):</label>
    <input 
      id="interval" 
      type="number" 
      value="500" 
      min="50" 
      max="5000" 
      step="50"
      data-simulation-target="interval"
    />
    
    <button 
      data-simulation-target="startBtn"
      data-action="click->simulation#start"
    >
      Start
    </button>
    
    <button 
      data-simulation-target="stopBtn"
      data-action="click->simulation#stop"
      disabled
    >
      Stop
    </button>
  </div>
</div>